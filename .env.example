# Copy this file to .env.local and fill in real values. Never commit .env.local.

# Neon Postgres, pooled connection string (host contains "-pooler").
# Neon console > your project > Connect > turn on "Pooled connection".
DATABASE_URL="postgresql://USER:PASSWORD@HOST-pooler.REGION.aws.neon.tech/DBNAME?sslmode=require&channel_binding=require"

# Clerk keys: Clerk dashboard > your application > API keys.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY="pk_test_..."
CLERK_SECRET_KEY="sk_test_..."

# Clerk screens live in this app. Where signed-out visitors are sent.
NEXT_PUBLIC_CLERK_SIGN_IN_URL="/sign-in"
NEXT_PUBLIC_CLERK_SIGN_UP_URL="/sign-up"

# E2E suite (npm run e2e). Names only: put the values in .env.local. CI gets them
# from GitHub Actions secrets.

# Email of the dedicated Clerk test user. It must contain "+clerk_test", so the
# Clerk dev instance accepts the fixed code 424242.
E2E_CLERK_TEST_EMAIL=

# Lets the suite past Vercel Deployment Protection on a deployment. Vercel >
# Project > Settings > Deployment Protection > Protection Bypass for Automation.
VERCEL_AUTOMATION_BYPASS_SECRET=

# Optional: test a deployed URL instead of the local build. Leave it unset for a
# local run.
# E2E_BASE_URL=
